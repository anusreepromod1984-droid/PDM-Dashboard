# Base URL of the PDM backend (REST history API + Socket.IO). Socket.IO negotiates its
# own transport upgrade from this http(s):// origin — do not use a ws:// URL here.
# Points at the local backend/ service during development.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional overrides — only set these if the Socket.IO endpoint differs from
# NEXT_PUBLIC_API_URL, or the backend mounts it under a non-default path.
# NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
# NEXT_PUBLIC_SOCKET_PATH=/socket.io
